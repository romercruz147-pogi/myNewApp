NODE_ENV=development
PORT=8080

# Supabase project settings
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# JWT secret: use at least 32 random bytes in production
JWT_SECRET=replace-with-a-long-random-production-secret
JWT_EXPIRES_IN=7d

# Admin-only key used for first-time factory/provisioning calls
PROVISIONING_KEY=replace-with-a-long-random-provisioning-key

# Comma-separated allowed app origins. Use your deployed web/mobile dev URL(s).
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
BCRYPT_ROUNDS=12
