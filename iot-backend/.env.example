# ========================================
# ROMERS VENDO IOT BACKEND - ENVIRONMENT CONFIG
# ========================================

# === SERVER CONFIGURATION ===
# Port the backend will listen on
PORT=8080

# Environment: development, staging, production
NODE_ENV=development

# ========================================
# === SUPABASE DATABASE (PostgreSQL) ===
# Get these from: https://supabase.com → Project Settings → API
# ========================================

SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ========================================
# === JWT AUTHENTICATION ===
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ========================================

JWT_SECRET=replace-with-a-long-random-production-secret
JWT_EXPIRES_IN=7d

# ========================================
# === DEVICE PROVISIONING ===
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Used when creating new devices in backend
# ========================================

PROVISIONING_KEY=replace-with-a-long-random-provisioning-key

# ========================================
# === CORS (Cross-Origin Resource Sharing) ===
# Add all URLs where the mobile app will run
# Examples:
#   - http://192.168.0.100:19000     (Expo on PC)
#   - http://localhost:3000           (Web)
#   - https://api.yourdomain.com      (Production)
# ========================================

CORS_ORIGINS=http://localhost:19000,http://localhost:19001,http://192.168.0.100:19000,http://192.168.0.100:19001

# ========================================
# === BCRYPT PASSWORD HASHING ===
# Salt rounds for device secret hashing
# 10-12 recommended (higher = more secure but slower)
# ========================================

BCRYPT_ROUNDS=12
