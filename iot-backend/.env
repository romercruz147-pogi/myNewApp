# ========================================
# ROMERS VENDO BACKEND - LOCAL DEVELOPMENT CONFIG
# ========================================
# Copy this as .env in iot-backend/ folder
# Fill in your actual values from Supabase and Firebase

# ========================================
# SERVER CONFIGURATION
# ========================================
PORT=8080
NODE_ENV=development

# ========================================
# SUPABASE DATABASE
# Get from: supabase.com → Your Project → Settings → API
# ========================================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...your-actual-key...

# ========================================
# JWT SECURITY
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ========================================
JWT_SECRET=your_super_secure_secret_key_min_32_chars_long_random_string_12345
JWT_EXPIRES_IN=7d

# ========================================
# DEVICE PROVISIONING
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Used to authorize device provisioning requests
# ========================================
PROVISIONING_KEY=another_super_secure_provisioning_key_min_32_chars_12345

# ========================================
# CORS - ALLOWED ORIGINS
# Add all URLs where your app will run
# For development: Your PC IP with Expo port
# Format: http://192.168.0.100:19000 (no trailing slash)
# ========================================
CORS_ORIGINS=http://localhost:19000,http://localhost:19001,http://192.168.0.100:19000,http://192.168.0.100:19001

# ========================================
# BCRYPT HASHING
# Higher number = more secure but slower
# 10-12 recommended (12 for production)
# ========================================
BCRYPT_ROUNDS=12
