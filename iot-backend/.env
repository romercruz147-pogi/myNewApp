# ========================================
# CORS - ALLOWED ORIGINS
# Add all URLs where your app will run
# For development: Your PC IP with Expo port
# Format: http://192.168.0.100:19000 (no trailing slash)
# ========================================
CORS_ORIGINS=http://localhost:19000,http://localhost:19001,http://192.168.0.100:19000,http://192.168.0.100:19001

# ========================================
# BCRYPT HASHING
# Higher number = more secure but slower
# 10-12 recommended (12 for production)
# ========================================
BCRYPT_ROUNDS=12
